# EmailJS configuration for the contact form
# (src/components/contact/ContactForm.jsx)
#
# Setup:
#   1. Copy this file to `.env.local` (gitignored — never commit real values).
#   2. Fill in the three values from https://dashboard.emailjs.com
#      (Email Services → Service ID, Email Templates → Template ID,
#      Account → Public Key).
#   3. For Vercel deployments, add the same three variables in
#      Project Settings → Environment Variables, then redeploy.
#
# Vite only exposes variables prefixed with `VITE_` to the browser bundle.
# These are PUBLIC client-side values — never put an EmailJS PRIVATE key here.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
